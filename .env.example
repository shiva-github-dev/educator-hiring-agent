# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google service account used for Sheets + (delegated) Calendar.
# Share the Sheets/Calendar with this address.
# Value may be a file path OR base64-encoded JSON (Docker/PaaS friendly).
GCP_SA_JSON=C:/path/to/service-account.json

# Google Sheets: the spreadsheet id (from the URL) and worksheet names.
SPREADSHEET_ID=1abc...xyz
SHEET_EDUCATORS=Educators          # Google Form responses (read-only)
SHEET_CENTRES=Centres
SHEET_CENTRE_REQUESTS=CentreRequests
SHEET_CANDIDATES=Candidates
SHEET_CHECKER_VERDICTS=CheckerVerdicts
SHEET_LOG=Log
SHEET_DIAGNOSIS=Diagnosis
SHEET_PATCH=Patch
SHEET_RUN_STATE=RunState
SHEET_HEALTH=Health
SHEET_ROUND2=Round2

# Google Calendar: calendar to create round-2 interview events in (or "primary").
CALENDAR_ID=primary

# Error handling / Agent 6 (Developer Support)
EVENT_MAX_FAILURES=3
HEARTBEAT_STALE_MINUTES=30
LOGS_DIR=logs
SANDBOX_DIR=.sandbox
# Optional: set to run A6 sandbox auto-fix headlessly, e.g. "opencode"
OPENCODE_CLI=

# Bot Gmail used to send email (OAuth consent file from Google Cloud Console).
GMAIL_OAUTH_JSON=C:/path/to/gmail-oauth.json
GMAIL_BOT_ADDRESS=agent.bot@gmail.com

# whatsapp-web.js sidecar (Node). Milestone 2+.
WA_SIDECAR_URL=http://127.0.0.1:3001
# true = print instead of sending (safe), false = actually send via the sidecar
WA_DRY_RUN=true

# Calendly booking link for the AI knowledge check (email pre-fill is appended).
CALENDLY_BASE_URL=https://calendly.com/your-hiring/15min